{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/notifications/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/admin/notifications/",
      "permanent": true
    },
    {
      "source": "/admin/index.html",
      "destination": "/admin/notifications/",
      "permanent": true
    },
    {
      "source": "/book-here",
      "destination": "/book/",
      "permanent": true
    },
    {
      "source": "/tours",
      "destination": "/book/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen/",
      "destination": "/experiences/copenhagen-city-highlights/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen",
      "destination": "/experiences/copenhagen-city-highlights/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-3h/",
      "destination": "/experiences/copenhagen-harbor-extended/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-3h",
      "destination": "/experiences/copenhagen-harbor-extended/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-4h/",
      "destination": "/experiences/copenhagen-sea-fortress/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-4h",
      "destination": "/experiences/copenhagen-sea-fortress/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-land-tour/",
      "destination": "/experiences/copenhagen-land-tour/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-land-tour",
      "destination": "/experiences/copenhagen-land-tour/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-wine-tour/",
      "destination": "/experiences/copenhagen-wine-tour/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-wine-tour",
      "destination": "/experiences/copenhagen-wine-tour/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-malmo/",
      "destination": "/experiences/copenhagen-to-malmo/",
      "permanent": true
    },
    {
      "source": "/experiences/private-boat-copenhagen-malmo",
      "destination": "/experiences/copenhagen-to-malmo/",
      "permanent": true
    },
    {
      "source": "/experiences/city-highlights-10-people/",
      "destination": "/experiences/copenhagen-city-highlights-10/",
      "permanent": true
    },
    {
      "source": "/experiences/city-highlights-10-people",
      "destination": "/experiences/copenhagen-city-highlights-10/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/gyg/1/get-availabilities/", "destination": "/api/gyg-handler" },
    { "source": "/api/gyg/1/reserve/", "destination": "/api/gyg-handler" },
    { "source": "/api/gyg/1/book/", "destination": "/api/gyg-handler" },
    { "source": "/api/gyg/1/cancel-reservation/", "destination": "/api/gyg-handler" },
    { "source": "/api/gyg/1/cancel-booking/", "destination": "/api/gyg-handler" },
    { "source": "/api/admin/login", "destination": "/api/admin?route=login" },
    { "source": "/api/admin/login/", "destination": "/api/admin?route=login" },
    { "source": "/api/admin/logout", "destination": "/api/admin?route=logout" },
    { "source": "/api/admin/logout/", "destination": "/api/admin?route=logout" },
    { "source": "/api/admin/refresh", "destination": "/api/admin?route=refresh" },
    { "source": "/api/admin/refresh/", "destination": "/api/admin?route=refresh" },
    { "source": "/api/admin/get-bookings", "destination": "/api/admin?route=get-bookings" },
    { "source": "/api/admin/get-bookings/", "destination": "/api/admin?route=get-bookings" },
    { "source": "/api/admin/booking-action", "destination": "/api/admin?route=booking-action" },
    { "source": "/api/admin/booking-action/", "destination": "/api/admin?route=booking-action" },
    { "source": "/api/admin/create-booking", "destination": "/api/admin?route=create-booking" },
    { "source": "/api/admin/create-booking/", "destination": "/api/admin?route=create-booking" },
    { "source": "/api/admin/ops", "destination": "/api/admin?route=ops" },
    { "source": "/api/admin/ops/", "destination": "/api/admin?route=ops" },
    { "source": "/api/admin/get-blocks", "destination": "/api/admin?route=get-blocks" },
    { "source": "/api/admin/get-blocks/", "destination": "/api/admin?route=get-blocks" },
    { "source": "/api/admin/create-block", "destination": "/api/admin?route=create-block" },
    { "source": "/api/admin/create-block/", "destination": "/api/admin?route=create-block" },
    { "source": "/api/admin/delete-block", "destination": "/api/admin?route=delete-block" },
    { "source": "/api/admin/delete-block/", "destination": "/api/admin?route=delete-block" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}